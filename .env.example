APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

UPLOAD_DISK=public

# ==============================================================================
# AI CHATBOT & MULTI-PROVIDER POOL (Bể khóa thông minh đảm bảo API hoạt động vô tận)
# ==============================================================================
# Chọn provider chính: gemini, groq, openrouter, openai, kira
AI_PROVIDER=gemini

# Google Gemini (Hỗ trợ nhiều key cách nhau bằng dấu phẩy để tự động xoay tua khi hết quota)
# Ví dụ: GEMINI_API_KEYS=key1,key2,key3
GEMINI_API_KEY=
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-1.5-flash

# Groq Cloud (Tùy chọn: Miễn phí, cực nhanh với Llama 3.3 70B & Llama 3.1 8B)
GROQ_API_KEY=
GROQ_API_KEYS=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter (Tùy chọn: Cổng đa mô hình AI miễn phí)
OPENROUTER_API_KEY=
OPENROUTER_API_KEYS=
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# OpenAI / ChatGPT Compatible (Tùy chọn)
OPENAI_API_KEY=
OPENAI_API_KEYS=
OPENAI_MODEL=gpt-4o-mini

# Kira AI Service (https://kiraai.vn)
KIRAAI_API_KEY=
KIRAAI_BASE_URL=https://kiraai.vn/api/v1
KIRAAI_MODEL=kira-3.5-flash


# Cổng thanh toán & Webhook SePay
SEPAY_MERCHANT_ID=SP-TEST-DEMO
SEPAY_SECRET_KEY=spsk_live_testdemo1234567890
SEPAY_ENV=sandbox

# Tài khoản ngân hàng hiển thị VietQR (SePay Webhooks)
SEPAY_BANK_NAME=MBBank
SEPAY_ACC_NUMBER=0901234567
SEPAY_ACC_HOLDER="QUAN MOI"
SEPAY_WEBHOOK_SECRET=
SEPAY_WEBHOOK_API_KEY=
